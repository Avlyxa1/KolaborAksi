# Database (Prisma Postgres / PostgreSQL)
DATABASE_URL=prisma+postgres://localhost:51213/?api_key=YOUR_API_KEY

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Firebase Admin SDK (JSON credential — JANGAN commit ke repo)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server
PORT=3000
NODE_ENV=development
